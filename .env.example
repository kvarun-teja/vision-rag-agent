# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env stays on your machine (it's in .gitignore). This example file goes into git.

# Postgres + pgvector (matches the docker run command in the setup steps)
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/postgres

# Ollama runs the vision-language model locally
OLLAMA_URL=http://localhost:11434
VLM_MODEL=moondream
TEXT_MODEL=qwen2.5:3b

# Price per 1,000 tokens for the cost estimate (0 = local models are free)
COST_PER_1K_TOKENS=0
